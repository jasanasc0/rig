{
  "env": { "PONYTAIL_DEFAULT_MODE": "off", "MCP_TIMEOUT": "60000" },
  "permissions": { "additionalDirectories": ["{{RIG}}/example/work/briefs"] },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "figma@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "ponytail@ponytail": false,
    "claude-md-management@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "customerio@customerio": false,
    "i-have-adhd@i-have-adhd": false,
    "watch@claude-video": false,
    "supermemory@supermemory-plugins": false
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "node {{RIG}}/hooks/guard.cjs --project example --seat scribe || exit 2" }] }
    ],
    "SessionStart": [
      { "matcher": "startup", "hooks": [{ "type": "command", "command": "node {{RIG}}/hooks/refocus.cjs --project example --seat scribe" }, { "type": "command", "command": "node {{RIG}}/hooks/refocus.cjs --project example --seat scribe --claude-md" }] },
      { "matcher": "clear", "hooks": [{ "type": "command", "command": "node {{RIG}}/hooks/refocus.cjs --project example --seat scribe" }, { "type": "command", "command": "node {{RIG}}/hooks/refocus.cjs --project example --seat scribe --claude-md" }] },
      { "matcher": "compact", "hooks": [{ "type": "command", "command": "node {{RIG}}/hooks/refocus.cjs --project example --seat scribe" }, { "type": "command", "command": "node {{RIG}}/hooks/refocus.cjs --project example --seat scribe --claude-md" }] }
    ]
  }
}
